{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solidity-copilot.invalid/schemas/v1/candidate-input.schema.json",
  "title": "Solidity Copilot V1 candidate-visible task input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "compiler", "task", "required_source_files", "reference_context", "public_tests"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"type": "string", "pattern": "^task_[A-Za-z0-9_-]+$"},
    "compiler": {"$ref": "#/$defs/compiler"},
    "task": {"$ref": "#/$defs/task"},
    "required_source_files": {"type": "array", "items": {"$ref": "#/$defs/requiredFile"}},
    "reference_context": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "public_tests": {"type": "array", "items": {"$ref": "#/$defs/contentArtifact"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "compiler": {
      "type": "object", "additionalProperties": false,
      "required": ["solc_version", "evm_version", "optimizer_enabled", "optimizer_runs", "via_ir", "foundry_profile"],
      "properties": {
        "solc_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "evm_version": {"type": "string", "minLength": 1},
        "optimizer_enabled": {"type": "boolean"},
        "optimizer_runs": {"type": "integer", "minimum": 0},
        "via_ir": {"type": "boolean"},
        "foundry_profile": {"type": "string", "minLength": 1}
      }
    },
    "requirement": {
      "type": "object", "additionalProperties": false, "required": ["id", "text", "kind", "priority"],
      "properties": {"id":{"type":"string","minLength":1},"text":{"type":"string","minLength":1},"kind":{"type":"string","minLength":1},"priority":{"type":"string","enum":["must","should","may"]}}
    },
    "interface": {
      "type": "object", "additionalProperties": false, "required": ["artifact_id", "contract", "required_signatures"],
      "properties": {"artifact_id":{"type":"string","minLength":1},"contract":{"type":"string","minLength":1},"required_signatures":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}}
    },
    "invariant": {
      "type": "object", "additionalProperties": false, "required": ["id", "text", "check"],
      "properties": {"id":{"type":"string","minLength":1},"text":{"type":"string","minLength":1},"check":{"type":"string","minLength":1}}
    },
    "constraints": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_dependencies", "forbidden_operations", "allowed_output_paths", "required_target_paths", "max_output_bytes"],
      "properties": {
        "allowed_dependencies":{"type":"array","items":{"type":"string"}},
        "forbidden_operations":{"type":"array","items":{"type":"string"}},
        "allowed_output_paths":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/path"}},
        "required_target_paths":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/path"}},
        "max_output_bytes":{"type":"integer","minimum":1}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "summary", "requirements", "interfaces", "invariants", "constraints"],
      "properties": {
        "title":{"type":"string","minLength":1},"summary":{"type":"string","minLength":1},
        "requirements":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/requirement"}},
        "interfaces":{"type":"array","items":{"$ref":"#/$defs/interface"}},
        "invariants":{"type":"array","items":{"$ref":"#/$defs/invariant"}},
        "constraints":{"$ref":"#/$defs/constraints"}
      }
    },
    "contentArtifact": {
      "type": "object", "additionalProperties": false, "required": ["artifact_id", "path", "content", "content_sha256"],
      "properties": {"artifact_id":{"type":"string","minLength":1},"path":{"$ref":"#/$defs/path"},"content":{"type":"string"},"content_sha256":{"$ref":"#/$defs/digest"}}
    },
    "requiredFile": {
      "type": "object", "additionalProperties": false, "required": ["artifact_id", "path", "role", "content", "content_sha256"],
      "properties": {"artifact_id":{"type":"string","minLength":1},"path":{"$ref":"#/$defs/path"},"role":{"type":"string","minLength":1},"content":{"type":"string"},"content_sha256":{"$ref":"#/$defs/digest"}}
    },
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["artifact_id", "path", "line_range", "purpose", "content", "content_sha256"],
      "properties": {
        "artifact_id":{"type":"string","minLength":1},"path":{"$ref":"#/$defs/path"},
        "line_range":{"type":"object","additionalProperties":false,"required":["start","end"],"properties":{"start":{"type":"integer","minimum":1},"end":{"type":"integer","minimum":1}}},
        "purpose":{"type":"string","minLength":1},"content":{"type":"string"},"content_sha256":{"$ref":"#/$defs/digest"}
      }
    }
  }
}
