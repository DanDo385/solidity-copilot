{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solidity-copilot.invalid/schemas/v1/candidate-output.schema.json",
  "title": "Solidity Copilot V1 candidate output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "files", "generated_tests", "assumptions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"type": "string", "pattern": "^task_[A-Za-z0-9_-]+$"},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "generated_tests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "assumptions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "content": {"type": "string"}
      }
    }
  }
}
