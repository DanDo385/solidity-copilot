{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solidity-copilot.invalid/schemas/v1/canonical-record.schema.json",
  "title": "Solidity Copilot V1 canonical JSONL record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","id","split_group_id","task_family","provenance","license","compiler","task","required_source_files","reference_context","public_tests","target","tests","security"],
  "properties": {
    "schema_version":{"const":"1.0.0"}, "id":{"type":"string","pattern":"^task_[A-Za-z0-9_-]+$"},
    "split_group_id":{"type":"string","minLength":1}, "task_family":{"type":"string","minLength":1},
    "provenance":{"$ref":"#/$defs/provenance"}, "license":{"$ref":"#/$defs/license"}, "compiler":{"$ref":"#/$defs/compiler"}, "task":{"$ref":"#/$defs/task"},
    "required_source_files":{"type":"array","items":{"$ref":"#/$defs/requiredFile"}},
    "reference_context":{"type":"array","items":{"$ref":"#/$defs/reference"}},
    "public_tests":{"type":"array","items":{"$ref":"#/$defs/contentArtifact"}},
    "target":{"type":"object","additionalProperties":false,"required":["files"],"properties":{"files":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/contentArtifact"}}}},
    "tests":{"type":"object","additionalProperties":false,"required":["hidden","required_test_ids"],"properties":{"hidden":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/hiddenTest"}},"required_test_ids":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}}},
    "security":{"type":"object","additionalProperties":false,"required":["slither_config_artifact_id","slither_config_sha256","allowed_findings","manual_review_required"],"properties":{"slither_config_artifact_id":{"type":"string","minLength":1},"slither_config_sha256":{"$ref":"#/$defs/digest"},"allowed_findings":{"type":"array","items":{"type":"string"}},"manual_review_required":{"type":"boolean"}}}
  },
  "$defs": {
    "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "compiler":{"type":"object","additionalProperties":false,"required":["solc_version","evm_version","optimizer_enabled","optimizer_runs","via_ir","foundry_profile"],"properties":{"solc_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"evm_version":{"type":"string","minLength":1},"optimizer_enabled":{"type":"boolean"},"optimizer_runs":{"type":"integer","minimum":0},"via_ir":{"type":"boolean"},"foundry_profile":{"type":"string","minLength":1}}},
    "requirement":{"type":"object","additionalProperties":false,"required":["id","text","kind","priority"],"properties":{"id":{"type":"string","minLength":1},"text":{"type":"string","minLength":1},"kind":{"type":"string","minLength":1},"priority":{"type":"string","enum":["must","should","may"]}}},
    "interface":{"type":"object","additionalProperties":false,"required":["artifact_id","contract","required_signatures"],"properties":{"artifact_id":{"type":"string","minLength":1},"contract":{"type":"string","minLength":1},"required_signatures":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}}},
    "invariant":{"type":"object","additionalProperties":false,"required":["id","text","check"],"properties":{"id":{"type":"string","minLength":1},"text":{"type":"string","minLength":1},"check":{"type":"string","minLength":1}}},
    "constraints":{"type":"object","additionalProperties":false,"required":["allowed_dependencies","forbidden_operations","allowed_output_paths","required_target_paths","max_output_bytes"],"properties":{"allowed_dependencies":{"type":"array","items":{"type":"string"}},"forbidden_operations":{"type":"array","items":{"type":"string"}},"allowed_output_paths":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/path"}},"required_target_paths":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/path"}},"max_output_bytes":{"type":"integer","minimum":1}}},
    "task":{"type":"object","additionalProperties":false,"required":["title","summary","requirements","interfaces","invariants","constraints"],"properties":{"title":{"type":"string","minLength":1},"summary":{"type":"string","minLength":1},"requirements":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/requirement"}},"interfaces":{"type":"array","items":{"$ref":"#/$defs/interface"}},"invariants":{"type":"array","items":{"$ref":"#/$defs/invariant"}},"constraints":{"$ref":"#/$defs/constraints"}}},
    "contentArtifact":{"type":"object","additionalProperties":false,"required":["artifact_id","path","content","content_sha256"],"properties":{"artifact_id":{"type":"string","minLength":1},"path":{"$ref":"#/$defs/path"},"content":{"type":"string"},"content_sha256":{"$ref":"#/$defs/digest"}}},
    "requiredFile":{"type":"object","additionalProperties":false,"required":["artifact_id","path","role","content","content_sha256"],"properties":{"artifact_id":{"type":"string","minLength":1},"path":{"$ref":"#/$defs/path"},"role":{"type":"string","minLength":1},"content":{"type":"string"},"content_sha256":{"$ref":"#/$defs/digest"}}},
    "reference":{"type":"object","additionalProperties":false,"required":["artifact_id","path","line_range","purpose","content","content_sha256"],"properties":{"artifact_id":{"type":"string","minLength":1},"path":{"$ref":"#/$defs/path"},"line_range":{"type":"object","additionalProperties":false,"required":["start","end"],"properties":{"start":{"type":"integer","minimum":1},"end":{"type":"integer","minimum":1}}},"purpose":{"type":"string","minLength":1},"content":{"type":"string"},"content_sha256":{"$ref":"#/$defs/digest"}}},
    "hiddenTest":{"type":"object","additionalProperties":false,"required":["artifact_id","path","content","content_sha256","covers","kind"],"properties":{"artifact_id":{"type":"string","minLength":1},"path":{"$ref":"#/$defs/path"},"content":{"type":"string"},"content_sha256":{"$ref":"#/$defs/digest"},"covers":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"kind":{"type":"string","minLength":1}}},
    "artifactProvenance":{"type":"object","additionalProperties":false,"required":["artifact_id","path","blob_sha256","retrieved_from"],"properties":{"artifact_id":{"type":"string","minLength":1},"path":{"$ref":"#/$defs/path"},"blob_sha256":{"$ref":"#/$defs/digest"},"retrieved_from":{"type":"string","pattern":"^https://"}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["origin","artifacts","derivation"],"properties":{"origin":{"type":"object","additionalProperties":false,"required":["type","url","revision","repository_snapshot_sha256"],"properties":{"type":{"const":"git"},"url":{"type":"string","pattern":"^https://"},"revision":{"type":"string","pattern":"^[0-9a-f]{40}$"},"repository_snapshot_sha256":{"$ref":"#/$defs/digest"}}},"artifacts":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/artifactProvenance"}},"derivation":{"type":"object","additionalProperties":false,"required":["method","parent_record_ids","transform_version"],"properties":{"method":{"type":"string","minLength":1},"parent_record_ids":{"type":"array","items":{"type":"string","minLength":1}},"transform_version":{"type":"string","minLength":1}}}}},
    "license":{"type":"object","additionalProperties":false,"required":["spdx_expression","license_file_path","license_file_sha256","source_headers_verified","redistribution_allowed","modification_allowed","attribution_notice","review_status","reviewed_by","reviewed_at"],"properties":{"spdx_expression":{"type":"string","minLength":1},"license_file_path":{"$ref":"#/$defs/path"},"license_file_sha256":{"$ref":"#/$defs/digest"},"source_headers_verified":{"const":true},"redistribution_allowed":{"const":true},"modification_allowed":{"const":true},"attribution_notice":{"type":"string","minLength":1},"review_status":{"const":"approved"},"reviewed_by":{"type":"string","minLength":1},"reviewed_at":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}}}
  }
}
